{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiestate.local/rules.schema.json",
  "definitions": {
    "isoCountry": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "countryRef": {
      "description": "An ISO alpha-2 code, or @GROUP to expand a group from _meta.yaml.",
      "type": "string",
      "pattern": "^([A-Z]{2}|@[A-Z0-9_]+)$"
    },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "verdict": { "enum": ["ELIGIBLE", "CONDITIONAL", "ALTERNATIVE_STRUCTURE", "UNKNOWN", "NOT_ELIGIBLE"] },
    "propertyType": {
      "enum": ["house", "apartment", "new_build", "residential_land", "agricultural_land", "commercial"]
    },
    "status": { "enum": ["citizen", "permanent_resident", "temporary_resident", "non_resident"] },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status_in": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/status" } },
        "residing_in_target": { "type": "boolean" },
        "citizenship_any": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/countryRef" } },
        "citizenship_none": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/countryRef" } },
        "special_any": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "special_none": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "buyer_types": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["individual", "company", "trust"] }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "applies_to", "property_types", "verdict", "sources", "source_type"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 3 },
        "summary": { "type": "string", "minLength": 10 },
        "applies_to": { "$ref": "#/definitions/appliesTo" },
        "property_types": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/propertyType" } }
          ]
        },
        "zones": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verdict": { "$ref": "#/definitions/verdict" },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text"],
            "properties": {
              "kind": {
                "enum": [
                  "approval",
                  "minimum_price",
                  "quota",
                  "surcharge",
                  "structure",
                  "term_limit",
                  "registration",
                  "location",
                  "other"
                ]
              },
              "text": { "type": "string", "minLength": 5 }
            }
          }
        },
        "effective_from": { "$ref": "#/definitions/isoDate" },
        "effective_to": { "$ref": "#/definitions/isoDate" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "source_type": { "enum": ["statute", "regulator", "secondary", "general_knowledge"] },
        "last_verified": { "$ref": "#/definitions/isoDate" },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "source_type": { "enum": ["statute", "regulator", "secondary"] } } },
      "then": { "properties": { "sources": { "minItems": 1 } } }
    }
  },
  "jurisdiction": {
    "type": "object",
    "additionalProperties": false,
    "required": ["country", "name", "zones", "rules"],
    "properties": {
      "country": { "$ref": "#/definitions/isoCountry" },
      "name": { "type": "string" },
      "zones": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label"],
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "label": { "type": "string" },
            "description": { "type": "string" }
          }
        }
      },
      "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/rule" } }
    }
  },
  "meta": {
    "type": "object",
    "additionalProperties": false,
    "required": ["groups", "special_statuses"],
    "properties": {
      "groups": {
        "type": "object",
        "propertyNames": { "pattern": "^[A-Z0-9_]+$" },
        "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/isoCountry" } }
      },
      "special_statuses": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "country", "description"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
            "label": { "type": "string" },
            "country": { "$ref": "#/definitions/isoCountry" },
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}
