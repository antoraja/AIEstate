# Optional. Without these the globe uses Cesium's bundled offline Natural Earth imagery.
# Cesium ion token: enables Bing satellite imagery.
VITE_CESIUM_ION_TOKEN=
# Google Maps Platform key with the Map Tiles API enabled: enables Photorealistic 3D Tiles at
# city zoom. Billed per root-tile session — see RESEARCH.md before enabling.
VITE_GOOGLE_MAPS_API_KEY=
